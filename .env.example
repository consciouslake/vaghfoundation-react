# Web3Forms access key — powers the Contact and Volunteer forms.
# Get a free key at https://web3forms.com (just an email address,
# no account/login required) and put it in a new .env.local file:
#
#   VITE_WEB3FORMS_KEY=your-key-here
#
# .env.local is gitignored — never commit real keys.
VITE_WEB3FORMS_KEY=
